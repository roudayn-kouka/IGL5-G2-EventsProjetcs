# {{ ansible_managed }}
name: fst-devops

services:
  caddy:
    image: caddy:2.8.4-alpine
    restart: unless-stopped
    ports: ["80:80", "443:443"]
    environment:
      BASE_DOMAIN: ${BASE_DOMAIN}
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
    depends_on: [jenkins, nexus, sonarqube]

  jenkins:
    build: ./jenkins
    image: fst/jenkins:lts-devops
    restart: unless-stopped
    group_add: ["{{ getent_group['docker'][1] }}"]   # accès au socket Docker de l'hôte
    environment:
      JAVA_OPTS: "-Djenkins.install.runSetupWizard=false -Xmx{{ jenkins_java_heap }}"
      CASC_JENKINS_CONFIG: /var/jenkins_home/casc/jenkins.yaml
      JENKINS_ADMIN_PASSWORD: ${JENKINS_ADMIN_PASSWORD}
      NEXUS_PASSWORD: ${NEXUS_PASSWORD}
      GITHUB_USER: ${GITHUB_USER}
      GITHUB_TOKEN: ${GITHUB_TOKEN}
      ARGOCD_TOKEN: ${ARGOCD_TOKEN}
      SONAR_TOKEN: ${SONAR_TOKEN}
      SLACK_BOT_TOKEN: ${SLACK_BOT_TOKEN}
    volumes:
      - /var/jenkins_home:/var/jenkins_home
      - /var/run/docker.sock:/var/run/docker.sock

  nexus:
    image: sonatype/nexus3:3.70.1
    restart: unless-stopped
    environment:
      INSTALL4J_ADD_VM_PARAMS: "{{ nexus_jvm_params }}"
    volumes:
      - nexus_data:/nexus-data

  sonarqube:
    image: sonarqube:community
    restart: unless-stopped
    depends_on: [sonar-db]
    environment:
      SONAR_JDBC_URL: jdbc:postgresql://sonar-db:5432/sonar
      SONAR_JDBC_USERNAME: sonar
      SONAR_JDBC_PASSWORD: ${SONAR_DB_PASSWORD}
    volumes:
      - sonar_data:/opt/sonarqube/data
      - sonar_extensions:/opt/sonarqube/extensions
      - sonar_logs:/opt/sonarqube/logs

  sonar-db:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_USER: sonar
      POSTGRES_PASSWORD: ${SONAR_DB_PASSWORD}
      POSTGRES_DB: sonar
    volumes:
      - sonar_db:/var/lib/postgresql/data

volumes:
  caddy_data:
  nexus_data:
  sonar_data:
  sonar_extensions:
  sonar_logs:
  sonar_db:

# Copy to terraform.tfvars (ignored). Read docs/ACADEMY-DEMO.md first.
region = "us-east-1"
project = "fst-events"
enable_devops_ec2 = false
argocd_internal_load_balancer = false

# Full monitoring + Argo + five features + staging/prod need more than 8 GiB raw.
node_instance_type = "t3.large"
worker_count = 2
# Only used if the optional host is enabled:
devops_instance_type = "t3.large"
cluster_version = "1.34" # standard support ends 2026-12-02; verify before use

lab_role_arn = "REPLACE_WITH_LABROLE_ARN"
admin_cidr = "REPLACE_WITH_PUBLIC_IPV4/32"
platform_repo_url = "https://github.com/roudayn-kouka/IGL5-G2-EventsProjetcs.git"
# Child manifests/chart sources use main; reviewed changes must exist there.
gitops_revision = "main"
# Explicit consent to image deletion during a later confirmed demo teardown:
ecr_force_delete = true
# Supply TF_VAR_grafana_admin_password securely. No committed passwords/tokens.
# Slack defaults empty. Only enable notifications with real secrets supplied securely.
# SSH key is read ONLY if enable_devops_ec2=true. Windows example:
# ssh_public_key_path = "C:/Users/user/.ssh/id_ed25519.pub"
# devops_ami_id = "ami-..." # pin an Ubuntu AMI when enabling the optional host

# Compatible versions returned by us-east-1 DescribeAddonVersions on 2026-10-29.
addon_versions = {
  coredns            = "v1.13.2-eksbuild.62"
  kube-proxy         = "v1.34.6-eksbuild.62"
  vpc-cni            = "v1.23.2-eksbuild.8"
  aws-ebs-csi-driver = "v1.67.2-eksbuild.1"
  metrics-server    = "v0.9.0-eksbuild.14"
}

# Copier en terraform.tfvars (ignoré par Git) puis : terraform init && terraform apply
region                 = "eu-west-3"
platform_repo_url      = "https://github.com/roudayn-kouka/IGL5-G2-EventsProjetcs.git"
admin_cidr             = "196.203.10.20/32"     # votre IP publique
ssh_public_key_path    = "~/.ssh/id_ed25519.pub"

# Compte AWS Academy uniquement :
# lab_role_arn = "arn:aws:iam::<compte>:role/LabRole"
# Supply TF_VAR_grafana_admin_password securely (at least 16 characters).
# Real tokens belong in secure environment variables, never committed examples.
enable_devops_ec2 = true
argocd_internal_load_balancer = true

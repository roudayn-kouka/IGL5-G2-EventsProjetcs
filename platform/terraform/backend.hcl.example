# One account/region/key for the WHOLE team, reused later by Jenkins.
# Bucket must already exist. No credentials belong in backend configuration.
bucket       = "fst-events-tfstate-ACCOUNT_ID-us-east-1"
key          = "platform/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
use_lockfile = true
# Existing DynamoDB users can retain dynamodb_table during a reviewed transition.
# Never change bucket/key or migrate an existing state automatically.

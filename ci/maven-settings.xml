<?xml version="1.0" encoding="UTF-8"?>
<!--
  Settings Maven utilisés par Jenkins pour publier dans Nexus.
  Les identifiants viennent des variables d'environnement injectées par
  withCredentials (credential Jenkins « nexus-credentials ») : aucun secret dans Git.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
    <servers>
        <server>
            <id>nexus</id>
            <username>${env.NEXUS_USR}</username>
            <password>${env.NEXUS_PSW}</password>
        </server>
    </servers>
</settings>

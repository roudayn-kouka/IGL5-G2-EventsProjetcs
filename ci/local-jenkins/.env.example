# Public key only; paste its single-line .pub content, without quotes.
# Add the corresponding PRIVATE key only through Jenkins Credentials.
JENKINS_AGENT_SSH_PUBKEY=

# Directory OUTSIDE this repository containing a file named `credentials` with
# only the current AWS Academy [default] profile. Never commit that file.
# Example (Windows): C:/Users/your-user/AppData/Local/events-demo/aws
ARGOCD_TUNNEL_CREDENTIALS_DIR=
# The defaults are us-east-1 and fst-events; override only for another lab.
AWS_REGION=us-east-1
EKS_CLUSTER_NAME=fst-events

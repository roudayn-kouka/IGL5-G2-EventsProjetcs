// =============================================================================
//  Events Project · Jenkinsfile.infra — crée / détruit l'infrastructure AWS (Learner Lab)
//  avec le Terraform de l'équipe : platform/terraform (VPC + EKS + ECR + Argo CD + application racine).
//
//  Jenkins tourne sur ton PC : on lance Terraform en « mode PC » grâce aux 3 variables ajoutées à platform/terraform
//  (valeurs par défaut inchangées pour l'équipe) :
//      create_devops_ec2 = false   pas d'EC2 « usine DevOps » (Jenkins, Nexus, SonarQube sont déjà sur ton PC)
//      argocd_public     = true    NLB Argo CD public, mais ouvert seulement à ton IP (admin_cidr)
//      appset_only_env   = participant   seul l'environnement participant est déployé (pas staging ni prod)
//      eks_raw           = true    cluster EKS en ressources simples : le module EKS lit iam:GetRole, refusé par ton Learner Lab
//  L'état Terraform est local (backend_override.tf généré ici) : pas de bucket S3 ni de table DynamoDB.
//
//  Job à part : Jenkins > New Item > « Pipeline » > « Pipeline script from SCM » > Git, dépôt de l'application,
//  credentials github-credentials, branche feature/participant, Script Path = Jenkinsfile.infra.
//  Pas de webhook : on le lance à la main (Build with Parameters).
//
//  ACTION = plan-only : init + validate + plan (ne change rien dans AWS)          <- par défaut
//  ACTION = apply     : plan + approbation + terraform apply + token Argo CD + ApplicationSet filtré
//  ACTION = destroy   : approbation + nettoyage du cluster + terraform destroy
//
//  Credentials Jenkins : aws_access_key_id, aws_secret_access_key, aws_session_token (Secret text, à recopier
//  à chaque session Learner Lab), grafana-admin-password (Secret text), github-credentials (Username + token).
// =============================================================================

def withAws(Closure body) {
  withCredentials([
    string(credentialsId: 'aws_access_key_id',     variable: 'AWS_ACCESS_KEY_ID'),
    string(credentialsId: 'aws_secret_access_key', variable: 'AWS_SECRET_ACCESS_KEY'),
    string(credentialsId: 'aws_session_token',     variable: 'AWS_SESSION_TOKEN')
  ]) { body() }
}

// Clés AWS + variables sensibles de Terraform (jamais écrites dans un fichier)
def withTf(Closure body) {
  withAws {
    withCredentials([
      string(credentialsId: 'grafana-admin-password', variable: 'TF_VAR_grafana_admin_password'),
      usernamePassword(credentialsId: 'github-credentials', usernameVariable: 'GH_USER', passwordVariable: 'TF_VAR_github_token')
    ]) { body() }
  }
}

def notify(String color, String text) {
  try { slackSend(channel: '#igl5-g2-ci', color: color, message: text) }
  catch (e) { echo "Slack non configuré : ${text}" }
}

pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '10'))
    timeout(time: 120, unit: 'MINUTES')
  }

  parameters {
    choice(name: 'ACTION', choices: ['plan-only', 'apply', 'destroy'],
           description: 'plan-only = ne change rien | apply = crée VPC + EKS + ECR + Argo CD | destroy = tout supprimer')
    string(name: 'CLUSTER_VERSION', defaultValue: '1.35',
           description: 'Version Kubernetes en SUPPORT STANDARD (le support étendu coûte 6 fois plus). Liste : aws eks describe-cluster-versions')
  }

  environment {
    AWS_REGION         = 'us-east-1'
    AWS_DEFAULT_REGION = 'us-east-1'
    CLUSTER            = 'fst-events'                       // = variable « project » de platform/terraform
    TF_DIR             = 'platform/terraform'
    // L'état Terraform vit dans le volume Jenkins (survit au redémarrage du conteneur, n'est PAS dans Git).
    // Perds ce fichier et Terraform oublie ce qu'il a créé.
    TF_STATE           = '/var/jenkins_home/tfstate/fst-events.tfstate'
    TF_IN_AUTOMATION   = 'true'
    APPSET_ENV         = 'participant'                      // seul environnement déployé
    ARGOCD_DIR         = '/var/jenkins_home/argocd'         // adresse + token, lus par Jenkinsfile
    ARGOCD_OPTS        = '--grpc-web --plaintext'           // le serveur Argo CD de l'équipe est en HTTP (server.insecure)
    KUBECONFIG         = "${WORKSPACE}/.kubeconfig"
  }

  stages {

    // Init, validation, scan de sécurité statique. Aucune clé AWS nécessaire, rien n'est créé.
    stage('Terraform setup') {
      steps {
        writeFile file: "${env.TF_DIR}/backend_override.tf", text: """terraform {
  backend "local" {
    path = "${env.TF_STATE}"
  }
}
"""
        sh '''
          mkdir -p "$(dirname $TF_STATE)"
          terraform version
          trivy config --severity HIGH,CRITICAL --exit-code 0 --skip-dirs '**/.terraform' --format table -o trivy-iac.txt $TF_DIR
          cd $TF_DIR
          terraform init -input=false -reconfigure
          terraform validate
        '''
      }
    }

    // Identité AWS + valeurs propres à TA session : LabRole, ton IP publique (accès à l'API EKS et à Argo CD)
    stage('AWS identity') {
      steps {
        script {
          withAws {
            try { sh 'aws sts get-caller-identity' }
            catch (e) { error('AWS refuse les clés : recopie les 3 valeurs (Learner Lab > AWS Details > AWS CLI) dans les credentials Jenkins') }
            env.LAB_ROLE_ARN = sh(script: 'aws iam get-role --role-name LabRole --query Role.Arn --output text', returnStdout: true).trim()
            env.MY_IP        = sh(script: 'curl -fsS https://checkip.amazonaws.com', returnStdout: true).trim()
          }
          echo "LabRole : ${env.LAB_ROLE_ARN} · ton IP publique : ${env.MY_IP}"
          // Lu automatiquement par Terraform (*.auto.tfvars). Aucun secret ici.
          writeFile file: "${env.TF_DIR}/lab.auto.tfvars", text: """region             = "${env.AWS_REGION}"
lab_role_arn       = "${env.LAB_ROLE_ARN}"
cluster_version    = "${params.CLUSTER_VERSION}"
node_instance_type = "t3.large"
admin_cidr         = "${env.MY_IP}/32"
create_devops_ec2  = false
eks_raw            = true
argocd_public      = true
appset_only_env    = "${env.APPSET_ENV}"
"""
        }
      }
    }

    stage('Terraform plan') {
      when { expression { params.ACTION in ['plan-only', 'apply'] } }
      steps {
        script {
          withTf {
            sh '''
              cd $TF_DIR
              terraform plan -input=false -out=tfplan
              terraform show -no-color tfplan > "$WORKSPACE/tfplan.txt"
            '''
          }
        }
      }
    }

    stage('Approbation : créer l\'infrastructure') {
      when { expression { params.ACTION == 'apply' } }
      steps {
        timeout(time: 30, unit: 'MINUTES') {
          input message: 'Créer VPC + EKS + ECR + Argo CD maintenant ? (lis tfplan.txt dans les artefacts ; ça consomme du crédit tant que ça tourne)', ok: 'Créer'
        }
      }
    }

    // ~15 à 20 min : VPC, cluster EKS, nœuds, ECR, Argo CD (Helm), application racine
    stage('Déploiement AWS (terraform apply)') {
      when { expression { params.ACTION == 'apply' } }
      steps {
        script {
          withTf {
            sh '''
              cd $TF_DIR
              terraform apply -input=false tfplan
              aws eks update-kubeconfig --region $AWS_REGION --name $CLUSTER
              kubectl wait --for=condition=Ready nodes --all --timeout=600s
              kubectl get nodes
            '''
          }
        }
      }
    }

    // Jenkins (sur ton PC) appelle Argo CD par sa CLI : on récupère l'adresse du NLB et on crée le token du compte « jenkins »
    // (droits limités aux applications events/* : get et sync). Adresse et token changent à chaque nouveau cluster.
    stage('Argo CD : adresse + token') {
      when { expression { params.ACTION == 'apply' } }
      steps {
        script {
          withAws {
            sh '''
              set +x
              aws eks update-kubeconfig --region $AWS_REGION --name $CLUSTER >/dev/null
              H=""
              for i in $(seq 1 60); do
                H=$(kubectl -n argocd get svc argocd-server -o jsonpath='{.status.loadBalancer.ingress[0].hostname}' 2>/dev/null || true)
                [ -n "$H" ] && break
                echo "Load balancer Argo CD pas encore créé ($i/60)..."; sleep 10
              done
              [ -n "$H" ] || { echo "Le NLB d'Argo CD n'a pas d'adresse."; exit 1; }
              PW=$(kubectl -n argocd get secret argocd-initial-admin-secret -o jsonpath='{.data.password}' | base64 -d)

              # le DNS d'un load balancer neuf met quelques minutes à répondre : on réessaie
              for i in $(seq 1 40); do
                argocd login "$H:80" --username admin --password "$PW" >/dev/null 2>&1 && break
                echo "Argo CD pas encore joignable ($i/40)..."; sleep 15
              done
              TOKEN=$(argocd account generate-token --account jenkins --server "$H:80")
              [ -n "$TOKEN" ] || { echo "Génération du token échouée."; exit 1; }

              umask 077
              mkdir -p "$ARGOCD_DIR"
              printf '%s' "$H:80"  > "$ARGOCD_DIR/server"
              printf '%s' "$TOKEN" > "$ARGOCD_DIR/token"
              echo "Argo CD joignable sur http://$H ; token écrit dans $ARGOCD_DIR"
            '''
          }
        }
      }
    }

    // L'application racine (Terraform) a déjà demandé à Argo CD d'installer ingress-nginx, la supervision et le projet « events ».
    // Elle ne gère PAS l'ApplicationSet (appset_only_env) : on l'applique ici, limité à envs/participant. Sans cela il créerait
    // aussi staging et prod (dossiers déjà présents sur la branche gitops) avec des images introuvables.
    stage('ApplicationSet : environnement participant') {
      when { expression { params.ACTION == 'apply' } }
      steps {
        script {
          withAws {
            sh '''
              aws eks update-kubeconfig --region $AWS_REGION --name $CLUSTER >/dev/null
              for i in $(seq 1 60); do
                kubectl -n argocd get appproject events >/dev/null 2>&1 && break
                echo "En attente du projet Argo CD « events » ($i/60)..."; sleep 10
              done
              kubectl -n argocd get appproject events
              sed "s#envs/[*]/config.json#envs/$APPSET_ENV/config.json#" platform/gitops/platform/apps/40-events-environments.yaml | kubectl apply -f -
              kubectl -n argocd get applicationsets,applications

              # ingress-nginx est installé par Argo CD : on attend son load balancer (jusqu'à 15 min)
              for i in $(seq 1 90); do
                H=$(kubectl -n ingress-nginx get svc ingress-nginx-controller -o jsonpath='{.status.loadBalancer.ingress[0].hostname}' 2>/dev/null || true)
                [ -n "$H" ] && { echo "Load balancer ingress-nginx : $H"; exit 0; }
                echo "En attente d'ingress-nginx ($i/90)..."; sleep 10
              done
              echo "ingress-nginx n'a pas de load balancer : regarde l'application ingress-nginx dans Argo CD."; exit 1
            '''
          }
          echo """Infrastructure prête.
- L'application events-participant apparaît dans Argo CD après le premier run du Jenkinsfile (ApplicationSet : ~1 à 3 min).
- Mot de passe Grafana : celui du credential grafana-admin-password (utilisateur admin)
- Grafana : kubectl -n monitoring port-forward svc/monitoring-grafana 3000:80   -> http://localhost:3000
- Argo CD : http://<adresse dans ${env.ARGOCD_DIR}/server> (utilisateur admin, mot de passe :
  kubectl -n argocd get secret argocd-initial-admin-secret -o jsonpath='{.data.password}' | base64 -d)"""
        }
      }
    }

    stage('Approbation : tout détruire') {
      when { expression { params.ACTION == 'destroy' } }
      steps {
        timeout(time: 30, unit: 'MINUTES') {
          input message: 'DÉTRUIRE le cluster, les nœuds, le VPC et le dépôt ECR ?', ok: 'Détruire'
        }
      }
    }

    stage('Destruction (terraform destroy)') {
      when { expression { params.ACTION == 'destroy' } }
      steps {
        script {
          withTf {
            sh '''
              if aws eks describe-cluster --name $CLUSTER --region $AWS_REGION >/dev/null 2>&1; then
                aws eks update-kubeconfig --region $AWS_REGION --name $CLUSTER
                # 1. Argo CD ne doit plus recréer ; 2. on supprime les environnements et les Services LoadBalancer :
                #    sans cela les interfaces réseau AWS restent dans le VPC et terraform destroy bloque.
                kubectl -n argocd delete applicationsets,applications --all --timeout=180s || true
                kubectl get ns -o name | grep '^namespace/events-' | xargs -r kubectl delete --timeout=300s || true
                kubectl get svc -A -o jsonpath='{range .items[?(@.spec.type=="LoadBalancer")]}{.metadata.namespace}{" "}{.metadata.name}{"\\n"}{end}' | \
                  while read ns name; do kubectl -n $ns delete svc $name --timeout=300s || true; done
                sleep 90   # laisse AWS retirer les load balancers
              else
                echo "Aucun cluster : terraform destroy nettoiera seulement ce qui reste dans l'état"
              fi
              cd $TF_DIR
              terraform destroy -input=false -auto-approve
              rm -rf $ARGOCD_DIR   # l'adresse et le token ne valent plus rien
            '''
          }
        }
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'tfplan.txt, trivy-iac.txt', allowEmptyArchive: true
      sh 'rm -f $KUBECONFIG $TF_DIR/backend_override.tf $TF_DIR/lab.auto.tfvars $TF_DIR/tfplan'
    }
    success { script { notify('good',   "INFRA ${params.ACTION} OK  #${env.BUILD_NUMBER}  ${env.BUILD_URL}") } }
    failure { script { notify('danger', "INFRA ${params.ACTION} ÉCHEC  #${env.BUILD_NUMBER}  ${env.BUILD_URL}") } }
  }
}
